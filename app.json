{
  "expo": {
    "name": "Mongoose",
    "slug": "mongoose",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "mongoose",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ezephyrmor.mongoose",
      "buildNumber": "1",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Face ID is used to securely authenticate and protect your data.",
        "NSPhotoLibraryUsageDescription": "Allow Mongoose to add photos you choose to your diary entries.",
        "NSPhotoLibraryAddUsageDescription": "Allow Mongoose to save diary photos when you choose to keep them.",
        "NSCameraUsageDescription": "Allow Mongoose to take photos for your diary entries.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        }
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          }
        ],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": []
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#DDE7D8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ezephyrmor.mongoose",
      "versionCode": 2,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-local-authentication",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#DDE7D8",
          "imageWidth": 220
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Mongoose to add photos you choose to your diary entries.",
          "cameraPermission": "Allow Mongoose to take photos for your diary entries.",
          "microphonePermission": false
        }
      ],
      "expo-iap"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fd52d74f-de3b-4410-a9f3-9060fcdfb57b"
      }
    },
    "owner": "ezephyrmor"
  }
}
