{
  "name": "mongoose",
  "version": "1.0.0",
  "main": "index.tsx",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint app src tests --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "doctor": "npx expo-doctor",
    "init-app": "node scripts/init-app.js",
    "eas:build": "eas build",
    "eas:update": "eas update",
    "start:dev-client": "expo start --dev-client",
    "start:tunnel": "expo start --dev-client --tunnel",
    "ios:device": "expo run:ios --device",
    "ios:device:clean": "expo run:ios --device --no-build-cache",
    "clean:cache": "rm -rf .expo node_modules/.cache ios/build",
    "clean:ios": "rm -rf ios/build ~/Library/Developer/Xcode/DerivedData/Mongoose-*",
    "start:expo-go": "expo start",
    "start:lan": "expo start --dev-client --lan"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@hookform/resolvers": "^5.4.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@tanstack/react-query": "^5.101.4",
    "axios": "^1.18.1",
    "expo": "~57.0.14",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.12",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.13",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.4",
    "expo-font": "~57.0.0",
    "expo-haptics": "~57.0.1",
    "expo-linking": "~57.0.6",
    "expo-local-authentication": "~57.0.2",
    "expo-router": "~57.0.14",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "~57.0.13",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.82.0",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-pell-rich-editor": "^1.10.0",
    "react-native-reanimated": "^4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "^0.10.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
